@@ -2487,6 +2499,13 @@
       if (channel->block_type != 2) {
 	/* long blocks */
 	for (sb = 2; sb < sblimit; ++sb, l += 18) {
+#if defined(MP368K_IMDCT_L)
+	  if (channel->block_type == 0) {
+	    /* el núcleo también invierte las frecuencias de las subbandas impares */
+	    MP368K_IMDCT_L((const int32_t *)&xr[ch][l], (int32_t *)(*frame->overlap)[ch][sb], (int32_t *)&sample[0][sb], sb & 1);
+	    continue;
+	  }
+#endif
 	  III_imdct_l(&xr[ch][l], output, channel->block_type);

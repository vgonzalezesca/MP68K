 # include "mp368k_eq.h"
 
 /* --- Layer III ----------------------------------------------------------- */
@@ -2462,6 +2467,13 @@
 
 	/* long blocks */
 	for (sb = 0; sb < 2; ++sb, l += 18) {
+#if defined(MP368K_IMDCT_L)
+	  if (block_type == 0) {
+	    /* sin inversión aquí: III_freqinver(sample, 1) corre después, como antes */
+	    MP368K_IMDCT_L((const int32_t *)&xr[ch][l], (int32_t *)(*frame->overlap)[ch][sb], (int32_t *)&sample[0][sb], 0);

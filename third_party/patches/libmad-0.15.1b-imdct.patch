@@ -44,6 +44,11 @@
 # include "frame.h"
 # include "huffman.h"
 # include "layer3.h"
+
+/* mp368k: IMDCT de bloques largos en un núcleo aparte (asm 68040), ver src/synth_kernels.h */
+# if defined(MP368K_IMDCT_L)
+#  include "synth_kernels.h"

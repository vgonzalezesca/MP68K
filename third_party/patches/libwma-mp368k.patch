 /* x^(-1/4) in 16.16, for x given with frac_bits fractional bits */
+
+/* mp368k: bits de (float)x para 0 < x < 2^31, con el redondeo al par más cercano de IEEE 754. Reemplaza al
+   "u.f = (float)(fixed32)x" original: el 68LC040 no tiene FPU y un float aquí cuesta llamadas a libgcc en cada bloque. */
+static inline unsigned int mp368k_int_to_float_bits(unsigned int x)
+{
+    unsigned int e = 31, m;
+
+    while (!(x >> e))
+        e--;                                    /* posición del bit más alto */
+    if (e <= 23) {
+        m = (x << (23 - e)) & 0x7FFFFF;
+    } else {
+        unsigned int sh = e - 23, low = x & ((1u << sh) - 1), half = 1u << (sh - 1);
+
+        m = x >> sh;                            /* 24 bits con el bit implícito */
+        if (low > half || (low == half && (m & 1)))
+            m++;
+        if (m >> 24) {                          /* el redondeo llegó a 2^24: sube el exponente */
+            m >>= 1;
+            e++;
+        }
+        m &= 0x7FFFFF;
+    }
+    return ((e + 127) << 23) | m;
+}

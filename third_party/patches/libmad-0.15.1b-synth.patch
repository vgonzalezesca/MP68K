+/* mp368k: tabla de la ventana en 16 bits, D16 = (D + 2) >> 2, armada una sola vez */
+static int16_t mp368k_D16[17][32];
+static int mp368k_d16_ready;
+
+static
+void mp368k_d16_init(void)
+{
+  unsigned int i;
+
+  if (mp368k_d16_ready)
+    return;
+  for (i = 0; i < 17 * 32; ++i)
+    (&mp368k_D16[0][0])[i] = (int16_t) (((&D[0][0])[i] + 2) >> 2);
+  mp368k_d16_ready = 1;
+}
+# endif
